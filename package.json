{
  "author": "Pooria Arab",
  "bin": {
    "agentic-postcard": "./dist/cli.js",
    "agentic-postcard-mcp": "./dist/mcp-bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "^0.1.0",
    "zod": "^3.25.0"
  },
  "description": "Send, track, and cancel direct-mail postcards through Lob and PostGrid with a TypeScript SDK, CLI, MCP server, and local dry runs.",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "postcards",
    "direct-mail",
    "lob",
    "postgrid",
    "print-mail",
    "typescript",
    "nodejs",
    "cli",
    "mcp",
    "dry-run",
    "mail-tracking",
    "html-postcards"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "mcpName": "io.github.pooriaarab/agentic-postcard",
  "name": "agentic-postcard",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-postcard.git"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
